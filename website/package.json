{
  "name": "sagevani-website",
  "version": "1.0.0",
  "description": "SageVani blog website: Payload CMS in Next.js",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:unit && npm run test:int",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/int",
    "typecheck": "tsc --noEmit",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/unit",
    "test:coverage": "cross-env NODE_OPTIONS=--no-deprecation vitest run --coverage",
    "db:up": "docker compose up -d --wait",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:harden": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/harden-database.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:migrate": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate && npm run db:harden -- --require-schema",
    "deploy:build": "DATABASE_URL=${DATABASE_MIGRATION_URL:?Set DATABASE_MIGRATION_URL to the Supabase session-pooler URL} npm run deploy:migrate && npm run build",
    "owner:create": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/create-owner.ts",
    "owner:reset-password": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/reset-owner-password.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.8",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "undici": "7.30.0"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
