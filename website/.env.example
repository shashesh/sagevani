# Copy to .env and fill in. Never commit .env.

# Local database started by `npm run db:up`
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/sagevani

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Required for any database that is not local (Supabase): the PEM certificate from
# Project Settings → Database → SSL Configuration. Do not add sslmode to the URLs.
DATABASE_CA_CERT=

# Netlify production builds only: the Supabase session-pooler URL used for migrations.
# The deploy script reads it from the environment; setting it here has no effect.
DATABASE_MIGRATION_URL=

# Media storage (Supabase Storage). Leave all empty locally: uploads then go to website/uploads/.
# Required for any database that is not local; set all six or none.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=
MEDIA_PUBLIC_URL=
